# Lasciare "infra": e il nome dello stack in produzione (il deploy lo forza comunque).
COMPOSE_PROJECT_NAME=infra
API_IMAGE=ghcr.io/carlobonvicini/work-hours-api:latest
# APP_DOMAIN solo se vuoi Caddy su 80/443 (docker-compose.public.yml).
# In produzione e vuoto: il tunnel Cloudflare sul portatile punta a localhost:8080.
APP_DOMAIN=
HOST=0.0.0.0
PORT=8080
CORS_ORIGIN=http://localhost:3000,https://workhours.developerdomain.org
MOBILE_UPDATES_PUBLIC_BASE_URL=https://workhours.developerdomain.org
DATA_PROVIDER=postgres
POSTGRES_DB=workhours
POSTGRES_USER=workhours
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgres://workhours:change_me@db:5432/workhours
